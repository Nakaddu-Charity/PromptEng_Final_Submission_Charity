from openai import OpenAI


client = OpenAI(api_key="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")  # Replace with your key

# Initialize conversation history
conversation = [
    {"role": "system", "content": "You are a helpful assistant. Keep responses between 15 and 50 words."}
]

print("🤖 GPT-5 Chat Assistant")
print("Type 'save' to save conversation, 'summary' to summarize, or 'quit' to exit.\n")

while True:
    user_input = input("You: ").strip()

    # --- Handle empty input ---
    if not user_input:
        print("⚠️ Please type something.")
        continue

    # --- Exit condition ---
    if user_input.lower() == "quit":
        print("👋 Goodbye!")
        break

    # --- Save conversation to text file ---
    if user_input.lower() == "save":
        with open("conversation_history.txt", "w", encoding="utf-8") as f:
            for msg in conversation:
                f.write(f"{msg['role'].capitalize()}: {msg['content']}\n\n")
        print("✅ Conversation saved as 'conversation_history.txt'")
        continue

    # --- Summarize conversation ---
    if user_input.lower() == "summary":
        summary_prompt = conversation + [
            {"role": "user", "content": "Summarize this conversation in about 50 words."}
        ]
        try:
            summary_response = client.chat.completions.create(
                model="gpt-5",
                messages=summary_prompt
            )
            summary_text = summary_response.choices[0].message.content
            print("\n📝 Summary:", summary_text, "\n")
        except Exception as e:
            print("⚠️ Could not generate summary. Possible reasons: quota exceeded or network/API error.")
        continue

    # --- Append user's input to conversation history ---
    conversation.append({"role": "user", "content": user_input})

    # --- Send conversation to GPT-5 with retry (3 attempts) ---
    for attempt in range(3):
        try:
            response = client.chat.completions.create(
                model="gpt-5",
                messages=conversation
            )
            break
        except Exception as e:
            print(f"⚠️ API call failed (attempt {attempt+1}/3): {e}")
            if attempt == 2:
                print("❌ Could not reach GPT-5 after 3 attempts. Exiting.")
                quit()

    # --- Extract assistant reply ---
    assistant_reply = response.choices[0].message.content.strip()

    # --- Limit assistant reply to 15–50 words ---
    words = assistant_reply.split()
    if len(words) < 15:
        assistant_reply += " " + "..."  # Ensure minimum length
    elif len(words) > 50:
        assistant_reply = " ".join(words[:50])

    # --- Add assistant reply to conversation and print ---
    conversation.append({"role": "assistant", "content": assistant_reply})
    print(f"\nAssistant: {assistant_reply}\n")
